# Normaliza finales de línea: LF en el repositorio, sin importar el sistema operativo.
* text=auto eol=lf

# Scripts de Windows necesitan CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Archivos binarios: nunca se modifican.
*.pdf     binary
*.docx    binary
*.xlsx    binary
*.png     binary
*.jpg     binary
*.joblib  binary
*.parquet binary
*.pt      binary

# Los notebooks no cuentan para las estadísticas de lenguaje de GitHub.
*.ipynb linguist-documentation
