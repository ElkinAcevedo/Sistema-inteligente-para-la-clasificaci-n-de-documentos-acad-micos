# Copia este archivo como .env y ajusta los valores. Todas las variables usan el prefijo CLASIFICADOR_.
CLASIFICADOR_ENTORNO=desarrollo
CLASIFICADOR_URL_BASE_DATOS=sqlite:///./clasificador.db
CLASIFICADOR_RUTA_MODELOS=../models
CLASIFICADOR_TAMANO_MAXIMO_ARCHIVO_MB=10
CLASIFICADOR_UMBRAL_CONFIANZA_DOMINIO=0.60
CLASIFICADOR_UMBRAL_CONFIANZA_CONJUNTA=0.40
CLASIFICADOR_ORIGENES_CORS=["http://localhost:5173"]
